#!/bin/bash
# Rebuild the fail2ban ignore list from SUCCESSFUL mail logins of the last N days,
# limited to your home countries (a stolen password used from abroad must not become "good").
# Run daily from cron, then reload fail2ban.
set -u
CONF=${MSG_CONF:-/etc/mail-spray-guard.conf}
HOME_COUNTRIES="EG"
GEOIP_DB=/usr/share/GeoIP/GeoLite2-Country.mmdb
GOODIPS=/etc/fail2ban/jail.d/zz-mail-spray-guard-goodips.local
MAILLOG=/var/log/maillog
DAYS=14
ALWAYS_IGNORE="127.0.0.1/8 ::1"
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

logs() {
  find "$(dirname "$MAILLOG")" -maxdepth 1 -name "$(basename "$MAILLOG")-*.gz" -mtime "-$((DAYS + 1))" -exec zcat {} + 2>/dev/null
  find "$(dirname "$MAILLOG")" -maxdepth 1 -name "$(basename "$MAILLOG")-*" ! -name "*.gz" -mtime "-$((DAYS + 1))" -exec cat {} + 2>/dev/null
  cat "$MAILLOG" 2>/dev/null
}

ips=$(logs \
  | grep -E "(imap|pop3|submission)-login: Login:|sasl_username=" \
  | grep -v "authentication failed" \
  | grep -oE "rip=[0-9a-fA-F.:]+|client=[^[ ]*\[[0-9a-fA-F.:]+\]" \
  | sed -E 's/^rip=//; s/^client=[^[]*\[//; s/\]$//' \
  | grep -vE '^(::1|127\.0\.0\.1)$' | sort -u \
  | while read -r ip; do
      cc=$(mmdblookup --file "$GEOIP_DB" --ip "$ip" country iso_code 2>/dev/null | grep -oE '"[A-Z]{2}"' | tr -d '"')
      for c in $HOME_COUNTRIES; do [ "$cc" = "$c" ] && { printf '%s ' "$ip"; break; }; done
    done)

tmp=$(mktemp)
printf '# generated by msg-goodips — do not edit\n[DEFAULT]\nignoreip = %s %s\n' "$ALWAYS_IGNORE" "$ips" > "$tmp"
install -m 0644 "$tmp" "$GOODIPS"
rm -f "$tmp"
